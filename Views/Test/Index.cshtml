@model Demilingua.Models.TestSessionViewModel
@{
    ViewData["Title"] = "Examen";
    Layout = null; // Layout limpio para focus total (como una Activity pantalla completa)
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Haciendo Test</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!-- Para alertas bonitas -->
</head>
<body class="bg-light">

    <!-- Toolbar -->
    <div class="bg-primary text-white p-3 d-flex justify-content-between align-items-center shadow-sm">
        <h5 class="m-0" id="lblTitulo">Cargando test...</h5>
        <span class="badge bg-white text-primary fs-6">Puntos: <span id="lblPuntos">0</span></span>
    </div>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                
                <!-- Tarjeta de Pregunta (activity_test.xml) -->
                <div class="card shadow-lg border-0" id="cardPregunta" style="display:none;">
                    <div class="card-body p-5">
                        <span class="badge bg-secondary mb-3" id="lblProgreso">Pregunta 1/5</span>
                        
                        <!-- Contenido / Pregunta -->
                        <h3 class="card-title text-center mb-4" id="tvContenido">Pregunta aquí</h3>
                        
                        <!-- Opciones (si hay) -->
                        <p class="text-muted text-center fst-italic" id="tvOpciones"></p>

                        <!-- Input Respuesta -->
                        <div class="form-floating mb-3 mt-4">
                            <input type="text" class="form-control" id="etRespuesta" placeholder="Tu respuesta" autocomplete="off">
                            <label for="etRespuesta">Escribe tu respuesta aquí</label>
                        </div>

                        <!-- Botón Siguiente -->
                        <div class="d-grid">
                            <button class="btn btn-primary btn-lg" onclick="validarYContinuar()">
                                Siguiente <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Loader -->
                <div id="loader" class="text-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">Generando examen aleatorio...</p>
                </div>

            </div>
        </div>
    </div>

    <!-- Scripts con la lógica de TestActivity.java -->
    <script>
        // Datos de sesión pasados desde C#
        const cursoId = @Model.CursoId;
        const idiomaId = @Model.IdiomaId;
        const userId = @Model.UserId;

        let ejercicios = [];
        let indice = 0;
        let puntuacionTotal = 0;

        // Al cargar la página
        document.addEventListener("DOMContentLoaded", async () => {
            try {
                // 1. Obtener Test Aleatorio (api/test)
                const respTest = await fetch(`/Test/GetRandomTest?cursoId=${cursoId}`);
                const testData = await respTest.json();

                if (!testData.id) { throw new Error("No hay tests disponibles"); }
                
                document.getElementById("lblTitulo").innerText = testData.titulo;

                // 2. Obtener Ejercicios del Test (api/exercises)
                const respEj = await fetch(`/Test/GetExercises?testId=${testData.id}`);
                ejercicios = await respEj.json();

                if (ejercicios.length === 0) { throw new Error("Este test no tiene ejercicios"); }

                // 3. Mostrar primer ejercicio
                document.getElementById("loader").style.display = "none";
                document.getElementById("cardPregunta").style.display = "block";
                mostrarEjercicio();

            } catch (error) {
                Swal.fire('Error', error.message, 'error').then(() => {
                    window.location.href = '/Courses?idiomaId=' + idiomaId;
                });
            }
        });

        function mostrarEjercicio() {
            if (indice >= ejercicios.length) {
                finalizarTest();
                return;
            }

            const ej = ejercicios[indice];
            document.getElementById("tvContenido").innerText = ej.contenido;
            document.getElementById("lblProgreso").innerText = `Pregunta ${indice + 1} de ${ejercicios.length}`;
            
            // Formatear opciones como en Android
            let ops = ej.opciones || "";
            // Limpiar JSON array chars: ["a","b"] -> a, b
            ops = ops.replace(/[\[\]"]/g, '').replace(/,/g, '\n');
            document.getElementById("tvOpciones").innerText = ops;

            document.getElementById("etRespuesta").value = "";
            document.getElementById("etRespuesta").focus();
        }

        function validarYContinuar() {
            const ej = ejercicios[indice];
            const respuestaUsuario = document.getElementById("etRespuesta").value.trim();
            const respuestaCorrecta = ej.respuesta.trim();
            const puntosPregunta = parseInt(ej.puntos);

            if (respuestaUsuario === "") return; // No dejar vacío

            // Lógica de comparación de Android: equalsIgnoreCase
            if (respuestaUsuario.toLowerCase() === respuestaCorrecta.toLowerCase()) {
                puntuacionTotal += puntosPregunta;
                document.getElementById("lblPuntos").innerText = puntuacionTotal;
                Swal.fire({
                    icon: 'success',
                    title: '¡Correcto!',
                    text: `+${puntosPregunta} puntos`,
                    timer: 1000,
                    showConfirmButton: false
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Incorrecto',
                    text: `La respuesta era: ${respuestaCorrecta}`,
                    timer: 2000,
                    showConfirmButton: false
                });
            }

            indice++;
            setTimeout(mostrarEjercicio, 1000); // Pequeña pausa para ver el feedback
        }

        async function finalizarTest() {
            document.getElementById("cardPregunta").style.display = "none";
            document.getElementById("loader").style.display = "block";
            document.getElementById("loader").innerHTML = "<h3>¡Test Finalizado!</h3><p>Guardando progreso...</p>";

            // Enviar puntos al backend (POST /api/puntos)
            await fetch('/Test/SubmitPoints', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuarioId: userId, idiomaId: idiomaId, puntos: puntuacionTotal })
            });

            Swal.fire({
                title: '¡Felicidades!',
                text: `Has conseguido ${puntuacionTotal} puntos.`,
                icon: 'success',
                confirmButtonText: 'Volver a Cursos'
            }).then(() => {
                window.location.href = `/Courses/Index?idiomaId=${idiomaId}&nombre=Volver`;
            });
        }
    </script>
</body>
</html>
