@model Demilingua.Models.TestSessionViewModel
@{
    ViewData["Title"] = "Examen";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Demilingua - Lección</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body, html {
            height: 100vh;
            margin: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .top-bar {
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .progress {
            flex-grow: 1;
            height: 15px;
            margin: 0 20px;
            border-radius: 10px;
        }
        .content-area {
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow-y: auto;
        }
        .bottom-toast-container {
            position: fixed;
            bottom: 0;
            width: 100%;
            z-index: 1050;
        }
        .toast {
            border-radius: 0;
            padding: 15px;
            font-size: 1.2rem;
        }
        #btn-mic {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            font-size: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
        }
    </style>
</head>
<body class="bg-white">

    <!-- Top Bar -->
    <div class="top-bar">
        <a href="@Url.Action("Index", "Courses", new { idiomaId = Model.IdiomaId })" class="text-secondary fs-4"><i class="bi bi-x-lg"></i></a>
        
        <div class="progress bg-light">
            <div id="progressBar" class="progress-bar bg-success" role="progressbar" style="width: 0%;"></div>
        </div>

        <div id="corazonesContainer" class="d-flex">
            <i class="bi bi-heart-fill text-danger mx-1 fs-4"></i>
            <i class="bi bi-heart-fill text-danger mx-1 fs-4"></i>
            <i class="bi bi-heart-fill text-danger mx-1 fs-4"></i>
        </div>
    </div>
    
    <div class="d-none">
        <span id="lblTitulo"></span>
        <span id="lblPuntos">0</span>
    </div>

    <!-- Main Content -->
    <div class="content-area">
        <div class="w-100" style="max-width: 600px;">
            
            <!-- Pregunta Container -->
            <div id="cardPregunta" style="display:none; flex-direction: column;">
                
                <h3 class="fw-bold mb-4" id="tvContenido">Cargando...</h3>
                
                <!-- Input hidden real answer -->
                <input type="hidden" id="etRespuesta" />

                <!-- Opciones (Opción Múltiple) -->
                <div id="opcionesContainer" class="mb-4"></div>

                <!-- Input Texto (Traducción / Completar) -->
                <div id="inputContainer" class="mb-4" style="display:none;">
                    <textarea class="form-control form-control-lg bg-light" id="etRespuestaVisible" rows="3" placeholder="Escribe tu respuesta..." 
                              onchange="document.getElementById('etRespuesta').value=this.value" 
                              onkeyup="document.getElementById('etRespuesta').value=this.value"></textarea>
                </div>

                <!-- Micrófono (Pronunciación) -->
                <div id="micContainer" class="text-center mb-4" style="display:none;">
                    <button id="btn-mic" class="btn btn-outline-danger shadow-sm mb-3">
                        <i class="bi bi-mic-fill"></i>
                    </button>
                    <p id="micStatus" class="text-muted fs-5">Haz clic para hablar</p>
                </div>

                <!-- Botón Siguiente (Para input texto) -->
                <button id="btnSiguiente" class="btn btn-success btn-lg w-100 text-uppercase fw-bold py-3 mt-auto" style="display:none;">
                    Comprobar
                </button>
            </div>

            <!-- Loader / Fin -->
            <div id="loader" class="text-center">
                <div class="spinner-border text-success" style="width: 3rem; height: 3rem;" role="status"></div>
            </div>

        </div>
    </div>

    <!-- Toast Footer -->
    <div class="bottom-toast-container">
        <div id="testToast" class="toast align-items-center text-white bg-success border-0 w-100" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true">
            <div class="d-flex">
                <div class="toast-body fw-bold" id="testToastBody">
                    ¡Correcto!
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1"></script>
    <script>
        const cursoId = @Model.CursoId;
        const idiomaId = @Model.IdiomaId;
        const userId = @Model.UserId;
    </script>
    <script src="~/js/testSession.js"></script>
</body>
</html>