@{
    ViewData["Title"] = "Amigos";
    var friends = ViewBag.Friends as List<Dictionary<string, string>> ?? new List<Dictionary<string, string>>();
    var userNames = ViewBag.UserNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var searchResults = ViewBag.SearchResults as List<Dictionary<string, string>>;
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-people-fill me-2"></i>Comunidad</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Columna: Mis Amigos -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-person-check-fill me-1"></i> Mis Amigos (@friends.Count)
                </div>
                <ul class="list-group list-group-flush">
                    @if (friends.Count == 0)
                    {
                        <li class="list-group-item text-center text-muted py-5">
                            <i class="bi bi-people display-4 d-block mb-2"></i>
                            Aun no tienes amigos. Busca usuarios y anadelos.
                        </li>
                    }
                    @foreach (var friend in friends)
                    {
                        var amigoIdStr = friend.GetValueOrDefault("amigo_id") ?? "0";
                        var amigoId = int.TryParse(amigoIdStr, out var aid) ? aid : 0;
                        var nombre = userNames.ContainsKey(amigoId) ? userNames[amigoId] : $"Usuario #{amigoId}";
                        var estado = friend.GetValueOrDefault("estado") ?? "PENDIENTE";
                        var isPendiente = estado == "PENDIENTE";
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold">@nombre</span>
                                @if (isPendiente)
                                {
                                    <span class="badge bg-warning text-dark ms-2">Pendiente</span>
                                }
                                else
                                {
                                    <span class="badge bg-success ms-2">Amigo</span>
                                }
                            </div>
                            <div class="d-flex gap-1">
                                @if (isPendiente && friend.GetValueOrDefault("can_accept") == "true")
                                {
                                    <form method="post" asp-action="AcceptFriend">
                                        <input type="hidden" name="amigoId" value="@amigoId" />
                                        <button type="submit" class="btn btn-sm btn-success">Aceptar</button>
                                    </form>
                                }
                                <form method="post" asp-action="DeleteFriend">
                                    <input type="hidden" name="amigoId" value="@amigoId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Eliminar a @nombre?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Columna: Buscar Usuarios -->
        <div class="col-lg-5">
            <div class="card shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-search me-1"></i> Buscar Usuarios
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index" class="mb-3 d-flex">
                        <input type="text" name="query" class="form-control me-2" placeholder="Nombre..." required />
                        <button type="submit" class="btn btn-outline-primary">Buscar</button>
                    </form>

                    @if (searchResults != null)
                    {
                        <ul class="list-group">
                            @if (searchResults.Count == 0)
                            {
                                <li class="list-group-item text-muted">Sin resultados.</li>
                            }
                            @foreach (var user in searchResults)
                            {
                                var uid = user.GetValueOrDefault("id") ?? "0";
                                var uname = user.GetValueOrDefault("nombre") ?? "Usuario";
                                var uemail = user.GetValueOrDefault("correo") ?? "";
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold">@uname</span>
                                        <br /><small class="text-muted">@uemail</small>
                                    </div>
                                    <form method="post" asp-action="AddFriend">
                                        <input type="hidden" name="amigoId" value="@uid" />
                                        <button type="submit" class="btn btn-sm btn-primary">Anadir</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
