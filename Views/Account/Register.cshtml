@model Demilingua.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
        .card-register { border: none; border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 24px; width: 100%; max-width: 500px; }
        .btn-purple { background-color: #6200EE; color: white; border-radius: 24px; /* cornerRadius="24dp" */ }
    </style>
</head>
<body>
    <div class="card card-register bg-white">
        <div class="text-center mb-4">
            <img src="~/logo.jpeg" class="rounded-circle" width="100" />
            <h4 class="mt-3">Crear Cuenta</h4>
        </div>

        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

        <form asp-action="Register" method="post">
            <!-- Nombre -->
            <div class="mb-3">
                <input asp-for="Nombre" class="form-control" placeholder="Nombre completo" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <!-- Correo -->
            <div class="mb-3">
                <input asp-for="Correo" class="form-control" placeholder="Correo electrónico" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>
            <!-- Contraseña -->
            <div class="mb-3">
                <input asp-for="Password" class="form-control" placeholder="Contraseña" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <!-- Confirmar -->
            <div class="mb-3">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar contraseña" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Botón Registrar (activity_register.xml: btnRegistrar) -->
            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-purple py-2">REGISTRARSE</button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Login" class="text-decoration-none small text-secondary">¿Ya tienes cuenta? Inicia sesión</a>
        </div>
    </div>
</body>
</html>
