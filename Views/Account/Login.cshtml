@model Demilingua.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // Usamos layout null para que se vea limpio como el Splash/Login
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Demilingua</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        /* Replicando estilos de activity_login.xml */
        body {
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }
        .card-login {
            border: none;
            border-radius: 12px; /* cardCornerRadius="8dp" */
            box-shadow: 0 4px 8px rgba(0,0,0,0.1); /* elevation="8dp" */
            padding: 24px;
        }
        .btn-purple {
            background-color: #6200EE; /* color/purple_500 */
            color: white;
            border: none;
        }
        .btn-purple:hover {
            background-color: #3700B3;
            color: white;
        }
        .logo-img {
            width: 150px;
            height: 150px;
            object-fit: contain;
            margin-bottom: 32px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="text-center">
                    <!-- Placeholder para el logo (activity_login.xml: id/logo) -->
                    <!-- Puedes poner tu imagen real en wwwroot/images/logo.png -->
                    <img src="https://via.placeholder.com/150/6200EE/FFFFFF?text=Demilingua" alt="Logo" class="logo-img rounded-circle" />
                </div>

                <div class="card card-login bg-white">
                    <h4 class="text-center mb-4">Bienvenido</h4>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.Error</div>
                    }

                    <form asp-action="Login" method="post">
                        <!-- Correo (activity_login.xml: etEmail) -->
                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">Correo Electrónico</label>
                            <input asp-for="Correo" class="form-control" placeholder="ejemplo@correo.com" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <!-- Contraseña (activity_login.xml: etPassword) -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <input asp-for="Password" class="form-control" placeholder="******" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- Botón Login (activity_login.xml: btnLogin) -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-purple btn-lg">INICIAR SESIÓN</button>
                        </div>
                    </form>

                    <!-- Link Registro (activity_login.xml: tvRegister) -->
                    <div class="text-center mt-3">
                        <a asp-action="Register" class="text-decoration-none" style="color: #6200EE;">
                            ¿No tienes cuenta? Regístrate
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
