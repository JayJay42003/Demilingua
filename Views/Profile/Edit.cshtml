@model Demilingua.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <!-- Toolbar simulada (activity_edit_profile.xml: toolbar) -->
            <div class="d-flex align-items-center mb-3 bg-primary text-white p-3 rounded">
                <a asp-action="Index" class="text-white me-3"><i class="bi bi-arrow-left fs-4"></i></a>
                <h5 class="m-0">Editar Perfil</h5>
            </div>

            <div class="card shadow-sm p-4">
                @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <!-- Nombre (etNombre) -->
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <!-- Correo (etCorreo) -->
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">Correo</label>
                        <input asp-for="Correo" class="form-control" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <hr />
                    <small class="text-muted">Deja la contraseña vacía si no quieres cambiarla.</small>

                    <!-- Password (etPassword) -->
                    <div class="mb-3 mt-2">
                        <label asp-for="Password" class="form-label">Nueva Contraseña</label>
                        <input asp-for="Password" class="form-control" placeholder="******" />
                    </div>

                    <!-- Confirm Password (etConfirmarContrasena) -->
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="******" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <!-- Botón Guardar (btnSave) -->
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">GUARDAR</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
