@model Demilingua.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-5">
    <!-- Card centralizada replicando el diseño vertical de activity_profile.xml -->
    <div class="card shadow-sm mx-auto text-center p-4" style="max-width: 400px; border-radius: 16px;">
        
        <!-- Imagen de perfil (ivProfile) -->
        <div class="mb-3">
             <img src="https://via.placeholder.com/100/CCCCCC/FFFFFF?text=User" 
                  class="rounded-circle border border-3 border-white shadow-sm" 
                  width="100" height="100" alt="Avatar"/>
        </div>

        <!-- Nombre (tvName) -->
        <h3 class="fw-bold mb-1">@Model.Nombre</h3>
        
        <!-- Correo (tvEmail) -->
        <p class="text-muted mb-4">@Model.Correo</p>

        <!-- Botón Editar (btnEditProfile) -->
        <a asp-action="Edit" class="btn btn-outline-primary w-100 mb-2 rounded-pill">
            <i class="bi bi-pencil"></i> Editar Perfil
        </a>

        <!-- Botón Cerrar Sesión (btnLogout) -->
        <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
            <button type="submit" class="btn btn-danger w-100 rounded-pill" onclick="return confirm('¿Seguro que quieres cerrar sesión?');">
                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
            </button>
        </form>
    </div>
</div>
