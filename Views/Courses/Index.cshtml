@model List<Demilingua.Models.Curso>
@{
    ViewData["Title"] = "Cursos";
}

<div class="container mt-4">
    <!-- Toolbar (replicando toolbar de activity_course.xml) -->
    <div class="d-flex align-items-center mb-4 p-3 bg-dark text-white rounded">
        <a asp-controller="Home" asp-action="Index" class="text-white me-3"><i class="bi bi-arrow-left fs-4"></i></a>
        <h4 class="m-0">Cursos de @ViewBag.IdiomaNombre</h4>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Mensaje Empty (tvEmpty) -->
        <div class="alert alert-info text-center p-5">
            <h4>No hay cursos disponibles para este idioma.</h4>
            <p>Intenta con otro idioma o vuelve más tarde.</p>
        </div>
    }
    else
    {
        <!-- RecyclerView (rvModulos) simulado con Grid de Bootstrap -->
        <div class="row g-4">
            @foreach (var curso in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <!-- Replica course_item.xml -->
                    <a asp-controller="Test" asp-action="Index" 
                       asp-route-cursoId="@curso.Id" 
                       asp-route-idiomaId="@ViewBag.IdiomaId"
                       class="text-decoration-none text-dark">
                       
                        <div class="card h-100 shadow-sm course-card hover-effect">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold text-primary">@curso.Nombre</h5>
                                <p class="card-text text-muted flex-grow-1">@curso.Descripcion</p>
                                
                                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                    <span class="badge bg-info text-dark">Nivel: @curso.Dificultad</span>
                                    <span class="text-primary"><i class="bi bi-play-circle-fill fs-4"></i></span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-effect:hover { transform: scale(1.02); transition: 0.2s; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15)!important; }
</style>
