@model Demilingua.Models.HomeViewModel
@{
    ViewData["Title"] = "Inicio";
}
<!-- Librería para banderas -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@6.6.6/css/flag-icons.min.css"/>

<div class="container py-4">
    <!-- Toolbar (activity_main.xml: toolbar) -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded text-white" style="background-color: #6200EE;">
        <h4 class="m-0">Selecciona un idioma</h4>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-light rounded-circle p-2">
            <i class="bi bi-person-fill" style="color: #6200EE;"></i>
        </a>
    </div>

    <!-- Lista de Idiomas (activity_main.xml: rvLanguages) -->
    <div class="row mb-5">
        @foreach(var idioma in Model.Idiomas)
        {
            <div class="col-md-4 mb-3">
                <!-- Replica language_item.xml -->
                <a asp-controller="Courses" asp-action="Index" asp-route-idiomaId="@idioma.Id" asp-route-nombre="@idioma.Name" 
                   class="card text-decoration-none text-dark h-100 shadow-sm hover-card">
                    <div class="card-body d-flex align-items-center">
                        <!-- Icono bandera -->
                        <span class="fi fi-@idioma.FlagCode rounded-circle me-3" style="font-size: 30px;"></span>
                        <div>
                            <h5 class="card-title m-0">@idioma.Name</h5>
                            <small class="text-muted">Nivel Básico - Avanzado</small>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <hr class="my-4" />

    <!-- Ranking Header (activity_main.xml: tvRankingHeader) -->
    <h4 class="text-danger fw-bold mb-3">Ranking Global 🏆</h4>

    <!-- Ranking List (activity_main.xml: rvRanking con item_ranking.xml) -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th>Idioma</th>
                            <th>Puntos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ranking != null && Model.Ranking.Any())
                        {
                            int pos = 1;
                            foreach (var item in Model.Ranking)
                            {
                                <tr>
                                    <td class="fw-bold">@(pos++)</td>
                                    <td>@item.Usuario</td>
                                    <td>@item.Idioma</td>
                                    <td class="fw-bold text-success">@item.Puntos</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted">Cargando ranking...</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card:hover { transform: translateY(-3px); transition: 0.2s; border-color: #6200EE; }
</style>
