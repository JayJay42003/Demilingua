@model Demilingua.Models.HomeViewModel
@{
    ViewData["Title"] = "Inicio";
}
<!-- Libreria para banderas -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@6.6.6/css/flag-icons.min.css"/>

<div class="container py-4">

@if (!User.Identity.IsAuthenticated)
{
    <!-- Landing / Hero para visitantes -->
    <div class="text-center py-5">
        <h1 class="display-3 fw-bold" style="color: #6200EE;">Demilingua</h1>
        <p class="lead mb-4">Aprende idiomas gratis con lecciones interactivas y gamificacion</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Account" asp-action="Register" class="btn btn-lg px-5 text-white" style="background-color: #6200EE; border-radius: 24px;">
                Empezar ahora
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-5" style="border-radius: 24px;">
                Iniciar Sesion
            </a>
        </div>
        <div class="mt-5 row text-center">
            <div class="col-md-4 mb-3">
                <div class="fs-1">&#x1F3AE;</div>
                <h5>Gamificacion</h5>
                <p class="text-muted">Gana puntos, rachas y compite en ligas</p>
            </div>
            <div class="col-md-4 mb-3">
                <div class="fs-1">&#x1F30D;</div>
                <h5>5 Idiomas</h5>
                <p class="text-muted">Ingles, Frances, Aleman, Italiano y Portugues</p>
            </div>
            <div class="col-md-4 mb-3">
                <div class="fs-1">&#x1F4F1;</div>
                <h5>Multiplataforma</h5>
                <p class="text-muted">Web + Android, sincronizado en tiempo real</p>
            </div>
        </div>
    </div>
}
else
{
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded text-white" style="background-color: #6200EE;">
        <div>
            <h4 class="m-0">Selecciona un idioma</h4>
            <small class="opacity-75">Elige un camino y continua aprendiendo</small>
        </div>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-light rounded-circle p-2">
            <i class="bi bi-person-fill" style="color: #6200EE;"></i>
        </a>
    </div>

    <!-- Lista de Idiomas -->
    <div class="row mb-5">
        @foreach(var idioma in Model.Idiomas)
        {
            <div class="col-md-4 mb-3">
                <a asp-controller="Courses" asp-action="Index" asp-route-idiomaId="@idioma.Id" asp-route-nombre="@idioma.Name" 
                   class="card text-decoration-none text-dark h-100 shadow-sm hover-card">
                    <div class="card-body d-flex align-items-center">
                        <span class="fi fi-@idioma.FlagCode rounded-circle me-3" style="font-size: 30px;"></span>
                        <div>
                            <h5 class="card-title m-0">@idioma.Name</h5>
                            <small class="text-muted">Nivel Basico - Avanzado</small>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

    <hr class="my-4" />

    <!-- Ranking Header -->
    <h4 class="text-danger fw-bold mb-3">Ranking Global</h4>

    <!-- Division Tabs -->
    <ul class="nav nav-pills mb-3 flex-wrap">
        @{
            var divNames = new[] { "Bronce", "Plata", "Oro", "Platino", "Diamante" };
            var divColors = new[] { "#cd7f32", "#c0c0c0", "#ffd700", "#e5e4e2", "#b9f2ff" };
            int? currentDiv = ViewBag.DivisionActual as int?;
        }
        <li class="nav-item">
            <a class="nav-link @(currentDiv == null ? "active" : "")" asp-action="Index" asp-route-division="">Global</a>
        </li>
        @for (int i = 0; i < 5; i++)
        {
            <li class="nav-item">
                <a class="nav-link @(currentDiv == i + 1 ? "active" : "")"
                   asp-action="Index" asp-route-division="@(i + 1)">
                    @divNames[i]
                </a>
            </li>
        }
    </ul>

    <!-- Ranking List (activity_main.xml: rvRanking con item_ranking.xml) -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th>Division</th>
                            <th>Racha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ranking != null && Model.Ranking.Any())
                        {
                            int pos = 1;
                            var medals = new[] { "&#x1F947;", "&#x1F948;", "&#x1F949;" };
                            foreach (var item in Model.Ranking)
                            {
                                var rowStyle = pos == 1 ? "background:linear-gradient(135deg,#fff9e6,#fff3cd)" :
                                               pos == 2 ? "background:#f8f9fa" :
                                               pos == 3 ? "background:#fdf2e9" : "";
                                <tr style="@rowStyle">
                                    <td class="fw-bold text-center">@(pos <= 3 ? Html.Raw(medals[pos-1]) : pos.ToString())</td>
                                    <td class="fw-bold">@item.Usuario</td>
                                    <td>@item.Idioma</td>
                                    <td class="fw-bold">
                                        <span class="badge bg-success me-1">@item.Puntos dias</span>
                                        <div class="progress mt-1" style="height:3px;width:60px;">
                                            <div class="progress-bar bg-warning" style="width:@(Math.Min(item.Puntos*2,100))%"></div>
                                        </div>
                                    </td>
                                </tr>
                                pos++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted">Cargando ranking...</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card:hover { transform: translateY(-3px); transition: 0.2s; border-color: #6200EE; }
</style>
